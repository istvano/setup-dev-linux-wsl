#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"

require_bash5

# tests/lib.sh holds shared assertions and is sourced, not run.
TESTS=(
  shell-syntax
  format
  placement-policy
  platform
  profiles
  apt
  render-brewfile
  homebrew
  chezmoi-templates
  identity
  bootstrap
  llm-relay
  shell-helpers
)

for test in "${TESTS[@]}"; do
  bash "$ROOT/tests/$test.sh"
done

echo 'All repository tests passed.'
