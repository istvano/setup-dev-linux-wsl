# Terminal conveniences, opt-in rather than in core. On the host because each one
# inspects or moves host state: processes, the filesystem and outbound ssh.
#
# htop is a second tool for btop's job. One-tool-per-job applies to the DEFAULT
# profile, which keeps btop alone; here a second tool is permitted.
brew "htop"               # Interactive process viewer whose keys match every Linux host reached by ssh.
brew "midnight-commander" # Two-pane terminal file manager (mc), with built-in sftp to remote hosts.
brew "rsync"              # Upstream rsync 3.x, the real rsync unlike macOS openrsync; newer than apt's.
