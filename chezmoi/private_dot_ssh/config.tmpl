{{- /* private_ so chezmoi applies 0600; ssh refuses a group-readable config.
Ported from setup-dev-mac, minus its Mac-specific keychain, agent socket and Colima settings. */ -}}
# SSH client configuration.
#
# Algorithm lists are allowlists rather than exclusions, so a future weak
# default cannot be silently negotiated.

# Included FIRST, deliberately. ssh takes the first value it obtains for each
# keyword, so anything after the `Host *` block below could never override it.
# Per-host settings live here and are not managed by the repository, so
# machine-specific hostnames never reach version control. A missing directory is
# not an error for Include.
Include ~/.ssh/config.d/*

Host *
  # Keys are added to an agent on first use, when one is running. There is no
  # keychain integration on Linux, and neither WSL nor a headless login starts an
  # agent by default; docs/OPERATIONS.md says how to run one.
  AddKeysToAgent yes

  # Only offer the key configured for a host. Without this, ssh walks every key
  # in the agent and leaks which identities exist to any server it contacts.
  # Under IdentitiesOnly, keys held solely in an agent are skipped; give a host in
  # config.d an `IdentityFile ~/.ssh/<name>.pub` to select one out of an agent.
  IdentitiesOnly yes

  HashKnownHosts yes
  StrictHostKeyChecking ask
  VerifyHostKeyDNS no

  KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
  HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
  PubkeyAcceptedAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256

  # Agent and X11 forwarding expose the client to a compromised server. Enable
  # them per host, deliberately, never globally.
  ForwardAgent no
  ForwardX11 no

  ServerAliveInterval 60
  ServerAliveCountMax 3

  # A per-machine key on disk, generated by run_after_12 and never copied
  # anywhere. A key that never leaves the machine that made it cannot be leaked by
  # losing a different machine, and git's ssh signing (which shells out to
  # ssh-keygen and ignores this file) can name the same file directly.
  #
  # Trade-off, stated rather than hidden: the key has no passphrase, so at rest it
  # is protected only by disk encryption. Add one with
  # `ssh-keygen -p -f ~/.ssh/id_ed25519`.
  IdentityFile ~/.ssh/id_ed25519
