#!/usr/bin/env bash
# Turn off the telemetry that no environment variable can reach (ADR-006, ADR-015, ADR-016).
#
# Most opt-outs live in the shell configuration as environment variables. These three have
# none: each is a setting the tool writes into its own config file, so it has to be set
# once, per machine, by running the tool. Ported from setup-dev-mac's hook 31.
#
# Settings: {{ range $i, $s := (list "go-telemetry-off" "gcloud-disable-usage-reporting" "aider-analytics-disable") }}{{ if $i }} {{ end }}{{ $s }}{{ end }}
#
# This is run_after_, not run_onchange_, on purpose (ADR-015). The hook exits 0 even when a
# step fails, and chezmoi records a run_onchange_ script as done on exit 0, so an offline
# first apply (aider not yet installed by hook 29) would mark it done and never retry. Run
# on every apply, it self-heals: each step is a guarded no-op when the setting is already
# correct (`mise which`, a marker file), so a re-apply is silent and costs no network.
# The settings line above only documents what the hook covers.
#
# Every step is guarded on the tool being present and is a no-op when the setting is
# already correct, so a re-apply is silent and costs no network.
#
# FINDING THE TOOLS: go comes from mise and aider from uv, and neither directory is on a
# run script's PATH, so `command -v` would fail for both, the hook would exit 0 and the
# setting would never be applied while reading as a clean run. The fix is per tool.
set -Eeuo pipefail

{{ template "brew-shellenv" . }}

# uv installs tool executables into ~/.local/bin, which is not on a run script's PATH.
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || export PATH="$HOME/.local/bin:$PATH"

# Go's telemetry defaults to "local": counters are written to disk and NOT uploaded
# unless the mode is "on". This declines to collect at all, the stricter of the two.
# `go telemetry` exists from Go 1.23; the guard covers an older toolchain.
#
# Located through mise with `mise which`, NOT `mise exec`. `mise exec` installs a missing
# tool in order to run it, so a telemetry opt-out could trigger a toolchain download, and
# the header promises no network on a re-apply. `mise which` only reports a path, exits
# non-zero when the tool is absent, and resolves the configured version.
go_bin="$(mise which go 2>/dev/null || true)"
if [[ -n "$go_bin" ]] && "$go_bin" telemetry >/dev/null 2>&1; then
  if [[ "$("$go_bin" telemetry 2>/dev/null)" != "off" ]]; then
    echo "[INFO] Disabling Go telemetry collection." >&2
    "$go_bin" telemetry off || echo "[WARN] Could not set Go telemetry to off." >&2
  fi
fi

# gcloud (cloud-gcp profile, from apt) reports usage only if you opted in at install time,
# so this is defensive: an installer question answered once is not a decision anyone
# remembers. `gcloud config set disable_usage_reporting true` is the verified opt-out
# setup-dev-mac uses. A no-op when already set; skipped when gcloud is not installed.
if command -v gcloud >/dev/null 2>&1; then
  if [[ "$(gcloud config get-value disable_usage_reporting 2>/dev/null)" != "True" ]]; then
    echo "[INFO] Disabling gcloud usage reporting." >&2
    gcloud config set disable_usage_reporting true >/dev/null 2>&1 ||
      echo "[WARN] Could not disable gcloud usage reporting." >&2
  fi
fi

# aider's analytics are opt-in and it asks before enabling them. --analytics-disable
# records a permanent "no", so the question is answered before it is asked.
#
# THREE things here are load-bearing:
#
# `</dev/null`. With stdin attached, `aider --analytics-disable --exit` keeps going after
# writing the setting: it offers an OpenRouter login and waits minutes for a browser
# callback, which under `>/dev/null 2>&1` looks like an apply that hangs.
#
# The marker is aider's own state file, ~/.aider/analytics.json, which
# `--analytics-disable` writes as permanently_disable. It does not write
# ~/.aider.conf.yml.
#
# The exit STATUS is not the test: aider exits non-zero on the no-API-key path although
# the setting was written. The file is checked afterwards instead.
aider_optout_recorded() {
  grep -qs '"permanently_disable"[[:space:]]*:[[:space:]]*true' \
    "$HOME/.aider/analytics.json" 2>/dev/null
}

if command -v aider >/dev/null 2>&1 && ! aider_optout_recorded; then
  echo "[INFO] Disabling aider analytics." >&2
  # Bounded explicitly so a future aider that prompts despite a closed stdin cannot stall
  # the apply. 60s is generous for a step the Mac measured at four.
  aider --analytics-disable --exit </dev/null >/dev/null 2>&1 &
  aider_pid=$!
  aider_waited=0
  while ((aider_waited < 60)) && kill -0 "$aider_pid" 2>/dev/null; do
    sleep 1
    aider_waited=$((aider_waited + 1))
  done
  if kill -0 "$aider_pid" 2>/dev/null; then
    kill -TERM "$aider_pid" 2>/dev/null || true
    sleep 1
    kill -KILL "$aider_pid" 2>/dev/null || true
    echo "[WARN] aider did not finish within ${aider_waited}s and was stopped." >&2
  fi
  wait "$aider_pid" 2>/dev/null || true
  aider_optout_recorded ||
    echo "[WARN] Could not disable aider analytics; run 'aider --analytics-disable'." >&2
fi

# Never fatal. chezmoi stops at the first failing script, so a telemetry setting that
# will not apply must not cost the hooks after this one.
exit 0
