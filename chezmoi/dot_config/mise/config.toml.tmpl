[settings]
experimental = true
idiomatic_version_file_enable_tools = ["node", "python", "java", "go"]
{{- if has "dev" .profiles }}
# Latest stable of every component, never an old pin (ADR-011). node follows its LTS
# line ("lts"); rust follows rustup's stable channel ("stable"); the JVM keeps three LTS
# major lines side by side (below); everything else is "latest". mise's `latest` skips
# prereleases for these backends (checked 2026-11-25: python hides 3.16 alphas, npm
# skips nightly dist-tags, aqua lists releases only). Reproducibility is traded for
# currency on purpose; this departs from setup-dev-mac's ADR-045.
[tools]
node = "lts"
go = "latest"
pnpm = "latest"
# Python is listed in idiomatic_version_file_enable_tools above, so it needs a [tools]
# entry too: otherwise mise honours a .python-version and installs nothing, and
# `python3` resolves to the distro build, which is not a runtime anyone chose. uv stays
# the project-level tool for dependencies and virtualenvs; this supplies the interpreter
# underneath it.
python = "latest"
# The JVM ecosystem, all of it, from the same manager that owns every other language.
# SDKMAN was considered and rejected: it needs a download-and-run installer that edits
# the shell rc files chezmoi owns, and mise covers the same ground.
#
# Three LTS major lines are kept side by side, each resolving to its latest patch: 21 is
# the default because it is first, 17 stays because Couchbase SDK and connector work
# still spans it, and 25 is the newest LTS, APPENDED so that mise (which takes the first
# entry as the default) does not move projects onto it unasked. `mise use
# java@temurin-25` in a project selects it. Major lines are not "latest": a JDK major is
# a compatibility boundary, not a patch.
java = ["temurin-21", "temurin-17", "temurin-25"]
maven = "latest"
gradle = "latest"
kotlin = "latest"
# mise manages Rust by driving rustup and installing rustup itself when absent,
# so Homebrew does not also install one.
rust = "stable"
# The one entry here that is a CLI rather than a runtime. Cline's own install
# instruction is `npm i -g cline`; that would land under whichever Node prefix mise
# currently owns and disappear at the next `node` bump, and run every lifecycle script in
# the tree. The npm: backend keeps it in the same file that decides the Node version, and
# mise orders node ahead of npm: tools. Do NOT add allow_builds: mise's embedded installer
# denies dependency lifecycle scripts by default, and cline's own postinstall is only a
# startup optimisation (a pre-built binary from a per-platform optional dependency).
"npm:cline" = "latest"
# OpenAI Codex CLI. Linux has no Homebrew formula (the macOS cask has no Linux build),
# so it comes from mise's aqua backend. The aqua registry strips the upstream tag
# prefix: release rust-v0.172.0 is version 0.172.0. The registry entry declares no
# checksum or attestation, so the archive is trusted on GitHub's TLS alone (TASKS.md).
# See ADR-009 and ADR-011.
"aqua:openai/codex" = "latest"
{{- end }}
