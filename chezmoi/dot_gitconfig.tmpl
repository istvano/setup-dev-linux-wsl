{{- /* Ported from setup-dev-mac/chezmoi/dot_gitconfig.tmpl, minus its Mac-specific
credential helper, password-manager signing program and pinentry settings. */ -}}
[user]
  name = {{ .gitName | quote }}
  email = {{ .gitEmail | quote }}
{{- if and .gitSigningKey (ne .gitSigningMethod "none") }}
{{- /*
  For the ssh method git treats user.signingkey as a FILE PATH. A literal public key
  must be prefixed `key::` unless it starts with `ssh-`, and ECDSA and security-key
  (sk-*) keys do not. Measured on the Mac, not assumed: a raw ecdsa-sha2-… value exits
  128 on commit, the same key as `key::ecdsa-sha2-…` works. The prefix is applied only
  to values that look like a public key, so a path or a GPG key ID passes untouched.
*/ -}}
{{- $signingKey := .gitSigningKey -}}
{{- if eq .gitSigningMethod "ssh" -}}
{{- if or (hasPrefix "ssh-" $signingKey) (hasPrefix "ecdsa-" $signingKey) (hasPrefix "sk-" $signingKey) -}}
{{- $signingKey = printf "key::%s" $signingKey -}}
{{- end -}}
{{- end }}
  signingkey = {{ $signingKey | quote }}
{{- end }}
[init]
  defaultBranch = main
[core]
{{- if lookPath "nvim" }}
  editor = nvim
{{- else }}
  editor = nano
{{- end }}
  pager = delta
  excludesfile = {{ joinPath .chezmoi.homeDir ".config/git/ignore" | quote }}
  # Line endings are never rewritten by git; .gitattributes decides per repository.
  # This matters on WSL, where Windows tooling touches the same working trees.
  autocrlf = false
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[diff]
  algorithm = histogram
  colorMoved = default
{{- if lookPath "code" }}
  tool = vscode
{{- end }}
[merge]
  conflictstyle = zdiff3
{{- if lookPath "code" }}
  tool = vscode
{{- end }}
{{- if lookPath "code" }}

# VS Code for interactive diffs and three-way merges. It does not replace delta:
# `git diff` goes through core.pager, while difftool and mergetool launch an external
# tool on demand. Both need a graphical session; over plain SSH `code --wait` has
# nothing to open and will hang, so use the terminal tools there. The absolute path
# is deliberate: a GUI Git client does not inherit the shell PATH.
[difftool]
  prompt = false
[difftool "vscode"]
  cmd = {{ lookPath "code" | quote }} --wait --diff $LOCAL $REMOTE
[mergetool]
  prompt = false
  # No .orig files left behind after a resolved conflict.
  keepBackup = false
[mergetool "vscode"]
  # `code --merge` takes path1, path2, base, result.
  cmd = {{ lookPath "code" | quote }} --wait --merge $LOCAL $REMOTE $BASE $MERGED
{{- end }}
# Git LFS, declared here rather than left to `git lfs install`, which writes exactly
# these keys into a file chezmoi owns. `required = true` makes a missing git-lfs binary
# an ERROR: without it, cloning a model repository quietly produces pointer files
# instead of weights, and the symptom looks like a corrupt model.
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[rerere]
  enabled = true
[pull]
  ff = only
[fetch]
  prune = true
[push]
  autoSetupRemote = true
  followTags = true
[submodule]
  recurse = true
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[rebase]
  autosquash = true

# The only credential helper is gh, and only for github.com. The empty `helper =`
# first clears any helper inherited from the system config, so nothing else can
# answer for that host. Other HTTPS remotes get no cache and prompt every time,
# which is deliberate: no plaintext credential store is configured.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

# Reject malformed objects instead of writing them into the object store. This
# is cheap and blocks a class of repository-delivered attacks.
[transfer]
  fsckObjects = true
[receive]
  fsckObjects = true
{{- $signing := and .gitSigningKey (ne .gitSigningMethod "none") }}
{{- if $signing }}
{{- if eq .gitSigningMethod "gpg" }}

# OpenPGP commit signing. `user.signingkey` above is the key ID; find it with
#   gpg --list-secret-keys --keyid-format=long
[gpg]
  format = openpgp
{{- if lookPath "gpg" }}
  # Absolute path so GUI Git clients, which do not inherit the shell PATH, find
  # the same gpg the shell does.
  program = {{ lookPath "gpg" | quote }}
{{- end }}
{{- else }}

# SSH commit signing with this machine's own key (run_after_12 generates
# it, run_after_13 writes the allowed_signers file). The private key never
# leaves the machine: revoking a lost machine is one action at the forge.
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" | quote }}
{{- end }}
[commit]
  gpgsign = true
[tag]
  gpgsign = true
{{- end }}
{{- if .workGitEmail }}

# Work repositories use a separate identity. Keep them under this path.
[includeIf {{ printf "gitdir:%s/" .workGitDir | quote }}]
  path = {{ joinPath .chezmoi.homeDir ".config/git/config-work" | quote }}
{{- end }}
