{{- if has "kubernetes" .profiles -}}
#!/usr/bin/env bash
# Install the declared kubectl plugins through krew (ADR-010).
#
# krew alone does nothing useful: `kubectl krew` runs, but no plugin is declared and a
# plugin installed by hand is not on PATH. The shells add ~/.krew/bin; this declares what
# belongs in it.
{{- /* The one place the list is declared. It is also printed below so that run_onchange,
       which hashes the rendered script, re-runs this hook when the list changes. */}}
{{- $plugins := list "neat" "view-secret" "tree" "whoami" "images" }}
#
# Plugins: {{ range $i, $p := $plugins }}{{ if $i }} {{ end }}{{ $p }}{{ end }}
#
# That line is load-bearing, not a summary: it is what makes this hook re-run when the
# list changes.
#
# A deliberate, narrow exception to ADR-003's package layers: these are third-party
# binaries fetched at apply time. What makes krew different is a difference of degree: it
# is one reviewed manager, the index is curated by kubernetes-sigs, and each plugin's
# version and download URL are pinned by that index rather than resolved from a branch.
# All five publish a linux/amd64 build (checked against krew-index, 2026-11-24).
#
# Failures are fatal on purpose, as in the runtimes hook: chezmoi records a run_onchange_
# script as done only when it exits 0, so exiting non-zero is what makes the next apply
# retry. Every plugin is still attempted before the hook fails, so one bad download does
# not hide the others.
set -Eeuo pipefail

{{ template "brew-shellenv" . }}

PLUGINS=({{ range $i, $p := $plugins }}{{ if $i }} {{ end }}{{ $p | quote }}{{ end }})

for tool in kubectl kubectl-krew; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[ERROR] $tool is not installed (the kubernetes profile provides it), so no krew plugins were installed. chezmoi retries this on the next apply." >&2
    exit 1
  fi
done

# Created before anything is installed so the directory exists even when every install
# below fails; fish and zsh both put it on PATH.
mkdir -p "$HOME/.krew/bin"

# The index has to exist before anything can be installed from it.
if ! kubectl krew update >/dev/null 2>&1; then
  echo "[ERROR] Could not update the krew index. chezmoi retries this on the next apply." >&2
  exit 1
fi

# Idempotent: ask krew what is present and install only the difference.
installed="$(kubectl krew list 2>/dev/null || true)"
failed=0
for plugin in "${PLUGINS[@]}"; do
  if printf '%s\n' "$installed" | grep -qx "$plugin"; then
    continue
  fi
  echo "[INFO] Installing kubectl plugin: $plugin" >&2
  kubectl krew install "$plugin" >/dev/null || {
    echo "[WARN] Could not install kubectl plugin: $plugin" >&2
    failed=$((failed + 1))
  }
done

if ((failed > 0)); then
  echo "[ERROR] $failed kubectl plugin(s) could not be installed. chezmoi retries this on the next apply; run \`kubectl krew install <name>\` to retry by hand." >&2
  exit 1
fi
{{- end }}
